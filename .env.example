NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Never expose to the browser.
# SUPABASE_SECRET_KEY=sb_secret_...
# Optional. Absolute origin used in auth redirect links. Defaults to the request host.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Error tracking (Sentry > Settings > Projects > kawaiimedicine > Client Keys). Safe in the browser.
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@oXXXXX.ingest.us.sentry.io/XXXXX
# Optional. Only needed to upload sourcemaps for readable production stack traces (Sentry > Settings > Auth Tokens).
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
